{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "existingOpenAiEndpoint": {
      "value": "${EXISTING_OPENAI_ENDPOINT}"
    },
    "existingOpenAiDeploymentName": {
      "value": "${EXISTING_OPENAI_DEPLOYMENT_NAME}"
    },
    "existingOpenAiEmbeddingDeploymentName": {
      "value": "${EXISTING_OPENAI_EMBEDDING_DEPLOYMENT_NAME}"
    },
    "existingOpenAiResourceId": {
      "value": "${EXISTING_OPENAI_RESOURCE_ID}"
    },
    "existingPostgresHost": {
      "value": "${EXISTING_POSTGRES_HOST}"
    },
    "existingPostgresDatabase": {
      "value": "${EXISTING_POSTGRES_DATABASE}"
    },
    "existingPostgresUser": {
      "value": "${EXISTING_POSTGRES_USER}"
    },
    "existingPostgresPassword": {
      "value": "${EXISTING_POSTGRES_PASSWORD}"
    },
    "postgresAdminPassword": {
      "value": "${POSTGRES_ADMIN_PASSWORD}"
    },
    "hierarchyLinkerEnabled": {
      "value": "${HIERARCHYLINKERENABLED=auto}"
    },
    "hierarchyLinkerShadowMode": {
      "value": "${HIERARCHYLINKERSHADOWMODE=false}"
    },
    "hierarchyLinkerRetrainJobEnabled": {
      "value": "${HIERARCHYLINKERRETRAINJOBENABLED=false}"
    },
    "aadFrontendClientId": {
      "value": "${AAD_FRONTEND_CLIENT_ID=}"
    },
    "aadFrontendTenantId": {
      "value": "${AAD_FRONTEND_TENANT_ID=}"
    },
    "aadApiTenantId": {
      "value": "${AAD_API_TENANT_ID=}"
    },
    "aadApiAppId": {
      "value": "${AAD_API_APP_ID=}"
    },
    "aadApiAudience": {
      "value": "${AAD_API_AUDIENCE=}"
    },
    "disableAuth": {
      "value": "${DISABLE_AUTH=false}"
    }
  }
}
